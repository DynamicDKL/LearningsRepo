Code 
DECLARE @CNT INT = (SELECT COUNT(LAT_N) FROM STATION);
DECLARE @MID_VALUES INT = (SELECT CASE WHEN @CNT%2 <> 0 THEN 1 ELSE 2 END);

IF @MID_VALUES = 1 
BEGIN 
WITH RANKED AS (
    SELECT LAT_N, ROW_NUMBER() OVER(ORDER BY LAT_N ASC) RWN,
    COUNT(*) OVER() CNT FROM STATION
)
SELECT CAST(LAT_N AS DECIMAL(10,4)) FROM RANKED
WHERE RWN = (CNT+1)/2
END 
ELSE
BEGIN
WITH RANKED AS (
    SELECT LAT_N, ROW_NUMBER() OVER(ORDER BY LAT_N ASC) RWN,
    COUNT(*) OVER() CNT FROM STATION
)
SELECT CAST(LAT_N AS DECIMAL(10,4)) FROM RANKED
WHERE RWN IN (CNT/2, (CNT/2)+1)
END 
